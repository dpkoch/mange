"""A Lie group "manifold geometry" C++ library, also with Python bindings"""

module(name = "mange")

bazel_dep(name = "eigen", version = "3.4.1")
bazel_dep(name = "googletest", version = "1.18.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "pybind11_bazel", version = "3.0.3")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_python", version = "2.5.1")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")

python.toolchain(
    python_version = "3.12",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

pip.parse(
    hub_name = "mange_pypi",
    python_version = "3.12",
    requirements_lock = "//:requirements_lock.txt",
)

# Hedron's Compile Commands Extractor for Bazel
# bazel run @hedron_compile_commands//:refresh_all
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)

git_override(
    commit = "85d83bc1ee3ab8034d9c40f6900a0753688068b6",
    module_name = "hedron_compile_commands",
    remote = "https://github.com/helly25/bazel-compile-commands-extractor.git",
)
